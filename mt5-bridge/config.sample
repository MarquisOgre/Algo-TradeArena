SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
MT5_GATEWAY_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/mt5-gateway
MT5_GATEWAY_SECRET=SET_IN_YOUR_LOCAL_ENV
BROKER_ACCOUNT_ID=SET_IN_YOUR_LOCAL_ENV
MT5_ACCOUNT_ID=SET_IN_YOUR_LOCAL_ENV
MT5_ROLE=paper_demo
MT5_LOGIN=SET_IN_YOUR_LOCAL_ENV
MT5_PASSWORD=SET_IN_YOUR_LOCAL_ENV
MT5_SERVER=SET_IN_YOUR_LOCAL_ENV
MT5_PATH=SET_IN_YOUR_LOCAL_ENV
MT5_ENVIRONMENT=demo
# paper_demo = Pepperstone MT5 Demo / Paper Trading; live = Pepperstone MT5 Live
# Never set MT5_ROLE=live and ALLOW_LIVE=true until Live Trading is explicitly enabled.
ALLOW_LIVE=false
POLL_SECONDS=2
QUOTE_BATCH_SIZE=400
UNIVERSE_BATCH_SIZE=300
ACCOUNT_SYNC_SECONDS=10
